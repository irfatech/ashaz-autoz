{
  "name": "ashaz-autoz",
  "version": "1.0.0",
  "private": true,
  "description": "Ashaz Autoz - Premium Automotive Services in Timor-Leste",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-sitemaps.cjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "check:content": "node scripts/check-content.mjs",
    "check:cms": "node scripts/check-cms-drift.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "format": "prettier --write src/",
    "astro": "astro"
  },
  "keywords": [
    "automotive",
    "timor-leste",
    "astro",
    "tailwindcss"
  ],
  "author": "Ashaz Autoz",
  "license": "MIT",
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/sitemap": "^3.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^7.0.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
